{"nodes": [{"id": "claude_beardify_project", "label": "Beardify (Vue 3 Spotify Client)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Project Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_collections_system", "label": "Collections System (#Collection convention)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Spotify Integration > Collections System", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Playlists whose name contains '#Collection' are treated as album collections. Chosen because it piggybacks on plain Spotify playlists: existing playlists can be converted to collections and back on the fly without breaking the user's existing organization, and no server-side storage is needed. Marked core business logic - must not be changed without maintainer approval."}, {"id": "claude_premium_only", "label": "Premium-Only Constraint", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Important Notes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spotify Web API playback endpoints reject free accounts, so the app targets premium users exclusively."}, {"id": "claude_pkce_auth", "label": "OAuth 2.0 PKCE Authentication", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Spotify Integration > Authentication", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PKCE avoids shipping a client secret in a browser app; token refreshed every 30 minutes and session persisted in localStorage."}, {"id": "claude_pinia_stores", "label": "Pinia Store Layer", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture > State Management", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_api_instance_helper", "label": "instance() API Helper", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "General agent guidance", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All Spotify Web API calls funnel through instance() from src/api.ts rather than raw ky, so auth headers and error handling live in one place. discogs.ts and other external APIs are the deliberate exception since they hit non-Spotify endpoints."}, {"id": "claude_optimistic_updates", "label": "Optimistic Player Updates", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Player Architecture > Optimistic Updates", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Player state is mutated locally before the API call resolves and reverted on failure, eliminating visual latency on play/pause/next/seek/shuffle/repeat and volume."}, {"id": "claude_volume_lock", "label": "Volume Lock Window", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Player Architecture > Optimistic Updates", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "setVolume() sets volumeLockUntil = Date.now() + VOLUME_LOCK_DURATION_MS so external playback-state polling cannot overwrite the optimistic volume while the request is in flight."}, {"id": "claude_loading_watchdog", "label": "Player Loading Watchdog", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Player Architecture > Loading Watchdog", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PlayerIndex.vue watches current_track.id; if null for 5s while no device switch is in progress it calls getExternalPlayerState() to recover from SDK stalls after a device switch."}, {"id": "claude_device_heartbeat", "label": "Device Heartbeat", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Player Architecture > Device Heartbeat", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs every 4 minutes to keep the active device alive; after 3 consecutive failures it notifies the user and reconnects, with a 5-minute cooldown to avoid notification spam."}, {"id": "claude_device_switch_state_machine", "label": "Device Switching State Machine", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Player Architecture > Device Switching State Machine", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "setDevice() queues targets in lastRequestedDeviceId while isSettingDevice is true so overlapping switch requests collapse into one; _finalizeDeviceSwitch() picks up the queued target."}, {"id": "claude_styling_system", "label": "Native CSS Theming System", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture > Styling System", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sass was dropped in favour of native CSS nesting plus custom properties (--bg-color-*, --font-color-*, --primary-color-*), imported once from App.vue. Component-local values become namespaced custom properties because bare names would inherit into child components and leak."}, {"id": "claude_font_utility_classes", "label": "Font Utility Classes", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture > Styling System", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the former @include font-bold Sass mixin: font-bold / font-italic / font-bold-italic classes bundle font-variation-settings with the @supports not font-tech(variations) fallback. Raw declarations stay local only for conditional cases (:hover, pseudo-elements, media queries) that a static class cannot express."}, {"id": "claude_custom_media_breakpoints", "label": "Custom Media Breakpoints", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture > Styling System", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native media conditions cannot take var(), so breakpoints live as @custom-media in breakpoints.css resolved at build time by postcss-custom-media; @csstools/postcss-global-data exposes them to every scoped <style> block with no per-file import."}, {"id": "claude_lint_pipeline", "label": "Lint Pipeline (TS + ESLint + Stylelint)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Essential Commands / ESLint Configuration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With no test framework in the project, linting is the primary quality gate; Prettier was removed and formatting moved into ESLint stylistic rules to keep a single source of truth."}, {"id": "claude_conventional_commits", "label": "Conventional Commits Policy", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Commit message formatting", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_flag_assets_pipeline", "label": "Flag SVG Asset Pipeline", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Static Assets", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "flag-icons SVGs are not bundled: dev serves them through Vite middleware from node_modules, prod copies them to dist/flags via vite-plugin-static-copy plus an explicit cp in netlify.toml."}, {"id": "claude_sdk_error_suppression", "label": "Spotify SDK Error Suppression", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Important Notes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-critical Spotify Web Playback SDK errors are intentionally swallowed in main.ts so console noise from the third-party SDK does not mask real failures."}], "edges": [{"source": "claude_collections_system", "target": "readme_collections", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Collections System", "weight": 1.0}, {"source": "claude_beardify_project", "target": "claude_collections_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Project Overview", "weight": 1.0}, {"source": "claude_collections_system", "target": "claude_api_instance_helper", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_pinia_stores", "target": "claude_api_instance_helper", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "CLAUDE.md", "source_location": "State Management", "weight": 1.0}, {"source": "claude_pkce_auth", "target": "claude_pinia_stores", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "AuthStore / Authentication", "weight": 1.0}, {"source": "claude_optimistic_updates", "target": "claude_pinia_stores", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Player Architecture", "weight": 1.0}, {"source": "claude_volume_lock", "target": "claude_optimistic_updates", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Optimistic Updates", "weight": 1.0}, {"source": "claude_loading_watchdog", "target": "claude_device_switch_state_machine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "isSettingDevice guard", "weight": 1.0}, {"source": "claude_device_switch_state_machine", "target": "claude_loading_watchdog", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Device Switching State Machine", "weight": 1.0}, {"source": "claude_device_heartbeat", "target": "claude_device_switch_state_machine", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "startDeviceHeartbeat calls setDevice()", "weight": 1.0}, {"source": "claude_device_heartbeat", "target": "claude_loading_watchdog", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_volume_lock", "target": "claude_loading_watchdog", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_sdk_error_suppression", "target": "index_spotify_playback_sdk", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CLAUDE.md", "source_location": "main.ts:19", "weight": 1.0}, {"source": "claude_loading_watchdog", "target": "index_spotify_playback_sdk", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CLAUDE.md", "source_location": "SDK stall recovery", "weight": 1.0}, {"source": "claude_font_utility_classes", "target": "claude_styling_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Styling System", "weight": 1.0}, {"source": "claude_custom_media_breakpoints", "target": "claude_styling_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Styling System", "weight": 1.0}, {"source": "claude_font_utility_classes", "target": "claude_custom_media_breakpoints", "relation": "sem