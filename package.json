{
  "name": "beardify",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:functions": "netlify dev",
    "lint": "vue-tsc --noEmit && tsc --noEmit -p netlify && eslint src/**/*.{vue,ts} netlify/**/*.mts && stylelint ./src/**/*.{vue,css}",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "bun run test && bun run lint && vite build",
    "fix": "eslint src/**/*.{vue,ts} netlify/**/*.mts --fix && stylelint ./src/**/*.{vue,css} --fix",
    "preview": "bun run build && vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "vite:dev-build": "vite build --mode development",
    "build:ci": "vite build",
    "build:app": "bun run tauri build && bun run scripts/package-release.ts",
    "release": "bun run scripts/release.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.26.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vueuse/motion": "^3.0.3",
    "bearded-ui": "github:BeardedBear/bearded-ui#release",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "flag-icons": "^7.5.0",
    "form-urlencoded": "^6.1.7",
    "ky": "^2.0.2",
    "oxlint": "^1.75.0",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pkce-challenge": "^6.0.0",
    "vue": "^3.5.40",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vueuse/core": "^14.3.0",
    "eslint": "^10.8.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.6",
    "netlify-cli": "^27.0.0",
    "normalize.css": "^8.0.1",
    "postcss": "^8.5.23",
    "postcss-custom-media": "^12.0.1",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.1"
  }
}
