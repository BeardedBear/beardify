{
  "name": "beardify",
  "version": "0.28.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:functions": "netlify dev",
    "lint": "vue-tsc --noEmit && tsc --noEmit -p netlify && eslint src/**/*.{vue,ts} netlify/**/*.mts && stylelint ./src/**/*.{vue,css}",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "bun run test && bun run lint && vite build",
    "fix": "eslint src/**/*.{vue,ts} netlify/**/*.mts --fix && stylelint ./src/**/*.{vue,css} --fix",
    "preview": "bun run build && vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "bun --env-file=.env run tauri build",
    "tauri:build:debug": "bun --env-file=.env run tauri build --debug",
    "vite:dev-build": "vite build --mode development",
    "build:ci": "vite build",
    "build:app": "bun run tauri:build && bun run scripts/package-release.ts",
    "release": "bun run scripts/release.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.71.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@vueform/slider": "^2.1.10",
    "@vueuse/motion": "^3.0.3",
    "bearded-ui": "github:BeardedBear/bearded-ui#release",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "flag-icons": "^7.6.0",
    "form-urlencoded": "^6.1.8",
    "ky": "^2.2.0",
    "oxlint": "^1.93.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pkce-challenge": "^6.0.0",
    "vue": "^3.5.45",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vueuse/core": "^15.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "netlify-cli": "^27.17.0",
    "normalize.css": "^8.0.1",
    "postcss": "^8.5.32",
    "postcss-custom-media": "^12.0.3",
    "postcss-html": "^2.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.2"
  }
}
